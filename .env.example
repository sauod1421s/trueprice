# TruePrice — قالب متغيرات البيئة (بلا أي قيمة سرية)
#
# لا تضع قيمًا حقيقية في هذا الملف ولا في أي ملف داخل Git.
# القيم الحقيقية تُضاف فقط في لوحة الاستضافة (Vercel → Settings → Environment Variables)
# أو في ملف .env.local على جهازك (مستبعد من Git).
#
# قاعدة ذهبية: أي متغير يبدأ بـ NEXT_PUBLIC_ يصل إلى المتصفح. لا تضع فيه سرًا أبدًا.
# مفتاح service_role / sb_secret_ لا يُستخدم في هذا الموقع إطلاقًا (لا في الواجهة ولا في الخادم).

# ---------------------------------------------------------------- مصدر البيانات
# static (الافتراضي إن تُرك فارغًا) = الموقع كما هو الآن من ملفات app/data بلا قاعدة.
# db = المنتجات والأسعار من قاعدة البيانات (Supabase أو المحلية).
TP_DATA_SOURCE=

# ---------------------------------------------------------------- قاعدة البيانات (سري — الخادم فقط)
# رابط دور التطبيق tp_app عبر Supavisor بوضع المعاملات (المنفذ 6543):
#   postgresql://tp_app.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# كلمة المرور تُولَّد داخل Supabase بالملف db/supabase/020_set_app_password.sql ولا تُكتب في Git.
# تحذير: من يملك هذا الرابط يستطيع التصرف بأي هوية داخل القاعدة؛ حساسيته مثل service_role.
DATABASE_URL=

# شهادة Supabase العامة (PEM) من: Database Settings → SSL Configuration → Download certificate.
# ليست سرًا لكنها إلزامية للاتصال بخادم بعيد (التحقق الكامل من هوية الخادم).
# في Vercel الصقها كما هي (أسطر متعددة)، أو في سطر واحد مع \n بين الأسطر.
DATABASE_CA_CERT=

# حجم مجموعة الاتصالات لكل نسخة خادم (1-10). الافتراضي 3 للقاعدة البعيدة — مناسب للخطة المجانية.
TP_DB_POOL_MAX=

# ---------------------------------------------------------------- Supabase Auth (عام — يصل للمتصفح)
# من Project Settings → API: رابط المشروع والمفتاح العام (publishable) فقط.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# بديل قديم للمفتاح العام إن لم يتوفر publishable (anon فقط، لا service_role):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- لوحة الإدارة
# اللوحة (/admin) تعيد 404 في الإنتاج ما لم تُفعَّل صراحة. اتركها فارغة حتى تقرر فتحها.
TRUEPRICE_ADMIN_PREVIEW=

# ---------------------------------------------------------------- عرض الأسعار المرجعية القديمة
# في وضع db: تُعرض أسعار الموقع القديمة في قسم منفصل موسوم "غير معتمدة" ولا تدخل في أي حساب.
# off = لا تُعرض إطلاقًا (لا يظهر إلا ما اعتمده مراجع).
TP_SHOW_LEGACY_REFERENCE=

# ---------------------------------------------------------------- محلي فقط (لا تضبطها على Vercel أبدًا)
# الدخول التجريبي بمستخدمي اختبار — يعمل فقط مع قاعدة محلية، ويُعطَّل تلقائيًا على Vercel.
# أوامر npm run mvp:* تضبطها تلقائيًا في .local/ فلا حاجة لكتابتها يدويًا.
# TP_PREVIEW_AUTH=
# TP_PREVIEW_SESSION_SECRET=
